<?xml version="1.0" encoding="UTF-8"?>
<!-- Déclaration du descripteur de déploiement pour une application web Java EE -->
<web-app
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://java.sun.com/xml/ns/javaee"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                        http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
    id="WebApp_ID" version="3.0">

    <!-- Nom affiché de l'application web -->
    <display-name>GestionDesProduitsMVC1</display-name>

    <!-- Liste des fichiers d'accueil (welcome files) -->
    <welcome-file-list>
        <!-- Si l'utilisateur accède à la racine du contexte, redirige vers listProduits -->
        <welcome-file>listProduits</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Déclaration de la servlet qui liste les produits -->
    <servlet>
        <servlet-name>list</servlet-name>
        <servlet-class>web.ListProduitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>list</servlet-name>
        <url-pattern>/listProduits</url-pattern>
    </servlet-mapping>

    <!-- Déclaration de la servlet qui ajoute un produit -->
    <servlet>
        <servlet-name>add</servlet-name>
        <servlet-class>web.AddProduitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>add</servlet-name>
        <url-pattern>/addProduit</url-pattern>
    </servlet-mapping>

    <!-- Déclaration de la servlet qui supprime un produit -->
    <servlet>
        <servlet-name>delete</servlet-name>
        <servlet-class>web.DeleteProduitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>delete</servlet-name>
        <url-pattern>/deleteProduit</url-pattern>
    </servlet-mapping>

    <!-- Déclaration de la servlet qui charge un produit pour modification -->
    <servlet>
        <servlet-name>edit</servlet-name>
        <servlet-class>web.EditProduitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>edit</servlet-name>
        <url-pattern>/editProduit</url-pattern>
    </servlet-mapping>

    <!-- Déclaration de la servlet qui met à jour un produit existant -->
    <servlet>
        <servlet-name>update</servlet-name>
        <servlet-class>web.UpdateProduitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>update</servlet-name>
        <url-pattern>/updateProduit</url-pattern>
    </servlet-mapping>

</web-app>
